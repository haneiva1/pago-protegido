# bot/.env: variables del bot de WhatsApp. SOLO TESTNET.
# Copia como .env y completa. NUNCA commitees el .env (está en .gitignore). Ver README.md, "Variables de entorno".

# App web
PP_APP_URL=http://localhost:3000
# URL de los links que ve la gente (túnel o dominio). Si no está, se usa PP_APP_URL.
PP_PUBLIC_URL=
# Clave compartida con la app para /api/bot/* (la misma PP_BOT_KEY del .env.local de la app).
PP_BOT_KEY=

# WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → API Setup). Solo para `npm start`.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Palabra larga inventada; la misma que pongas en el webhook de Meta.
WA_VERIFY_TOKEN=
# Clave secreta de la app de Meta (App settings → Basic → App secret). Obligatoria para `npm start`: sin ella el bot no
# arranca. Con ella comprueba la firma X-Hub-Signature-256 de cada webhook.
WA_APP_SECRET=

# Opcionales
# PORT=3040
# POLL_INTERVAL_MS=10000
# REMINDER_HOURS=2

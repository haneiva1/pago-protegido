# deploy/bot.env: variables de RUNTIME del bot de WhatsApp. SOLO TESTNET.
# Copia como bot.env y completa. NUNCA lo commitees. Ver bot/README.md.
# PP_APP_URL, PP_PUBLIC_URL y BOT_STATE_FILE los fija docker-compose.yml.

# Clave compartida con la app para /api/bot/* (la misma PP_BOT_KEY de app.env).
PP_BOT_KEY=

# WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → API Setup).
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Palabra larga inventada; la misma que pongas en el webhook de Meta.
WA_VERIFY_TOKEN=
# Clave secreta de la app de Meta (App settings → Basic → App secret). Obligatoria para `npm start`: sin ella el bot no
# arranca. Con ella comprueba la firma X-Hub-Signature-256 de cada webhook.
WA_APP_SECRET=

# Con Kapso en lugar de Meta directo (docs/WHATSAPP.md, "Con Kapso"): WA_PROVIDER=kapso, estas dos y WA_PHONE_NUMBER_ID.
# WA_TOKEN, WA_VERIFY_TOKEN y WA_APP_SECRET no se usan.
# WA_PROVIDER=meta
# KAPSO_API_KEY=
# KAPSO_WEBHOOK_SECRET=

# Opcionales
# POLL_INTERVAL_MS=10000
# REMINDER_HOURS=2

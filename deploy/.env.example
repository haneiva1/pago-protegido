# deploy/.env: lo lee docker compose (dominios y variables públicas del build).
# Copia como .env. SIN secretos: los secretos van en app.env y bot.env.

# Dominio de la app (un registro A/AAAA apuntando a este servidor). Caddy saca el certificado solo.
APP_DOMAIN=pago.ejemplo.com
# Dominio del webhook del bot (opcional; solo con --profile bot).
BOT_DOMAIN=bot.pago.ejemplo.com
# Correo para Let's Encrypt (avisos de vencimiento).
ACME_EMAIL=

# Se fijan en el BUILD de la app (quedan en el JavaScript del navegador: son públicas).
# local = llave generada en el navegador; pollar = login con Google/email (Pollar).
NEXT_PUBLIC_WALLET=local
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=

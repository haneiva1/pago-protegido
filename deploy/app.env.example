# deploy/app.env: variables de RUNTIME de la app web. SOLO TESTNET.
# Copia como app.env y completa. NUNCA lo commitees (está en .gitignore).
# Equivale al .env.local que genera `npm run setup` en pago-protegido/app.

# Modo de los contratos: guardian (pp_guardian + pp_arbiter) o direct.
PP_MODE=guardian
# IDs de testnet (contracts/DEPLOYED.md). Si se omiten, la app usa estos mismos.
PP_GUARDIAN_ID=CAOX6JZV3CJZFDD22J2XI3NKY5G4NRFOYRV7IA724MSVREYVRALW4OZU
PP_ARBITER_ID=CBCDVLEPJ6PN7RDC3HFGML3IUT7SOQEYSGH3LE3SWXWZJO7Z2QG2PWGU

# Llaves del servidor (S…). Son las 3 únicas que tiene: `stellar keys show <identidad>`.
# plataforma: rol platform, deploy de escrows y fee bump
PLATAFORMA_SECRET=
# arbitro: admin de pp_arbiter
ARBITRO_SECRET=
# lab: emisor de LABUSD (rampa simulada)
LAB_SECRET=

TWFEE_ADDRESS=GCK2H2G65HK3AJTFLFAAM4HD42EHAGRLIEYZ47UBJRJECNRDVZR6BYPX
LABUSD_CODE=LABUSD
LABUSD_SAC=CC65P6TQQ646YDXVS3PM6YVZASXW6WM5B67YKI46JH4EG65LJPOGBD4S
ESCROW_WASM_HASH=1b367bc8476cf80b89f6396e2aa07b602b78361dd829b5ce9b64ada365196660
PLATFORM_FEE_BPS=200
FX_BS_PER_USD=11.70

# Devolución completa (H-4 de contracts/DECISIONES.md). Apagada por defecto: el comprador recupera su pago menos las
# comisiones que descuenta Trustless Work, como siempre. Con 1, después de una devolución total (el vendedor no
# despachó a tiempo, o el revisor le da todo al comprador) Trato le transfiere esas comisiones desde la cuenta de la
# plataforma y la página y el bot dicen "Te devolvimos todo lo que pagaste". La plataforma necesita saldo de LABUSD.
# PP_DEVOLUCION_COMPLETA=1

# Clave del panel /arbitro (inventa una larga).
ARBITRO_PANEL_KEY=

# Pollar (testnet). La publishable key va en deploy/.env (build); estas son de servidor.
POLLAR_APP_ID=
POLLAR_SECRET_KEY=

# Clave compartida con el bot para /api/bot/* (bot/APP-ENDPOINTS.md §0). La misma que en bot.env.
PP_BOT_KEY=

# Base SQLite dentro del volumen (no cambiar en Docker).
PP_DB_PATH=/data/pp.db
